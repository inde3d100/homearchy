#!/usr/bin/env bash
set -euo pipefail

readonly bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

case "$(uname -m)" in
  aarch64 | arm64)
    engine="$bin_dir/homearchy-linux-arm64"
    ;;
  x86_64 | amd64)
    engine="$bin_dir/homearchy-linux-amd64"
    ;;
  *)
    printf 'Homearchy does not support architecture %s.\n' "$(uname -m)" >&2
    exit 64
    ;;
esac

if [[ ! -x "$engine" ]]; then
  printf 'Homearchy engine is missing or not executable: %s\n' "$engine" >&2
  exit 69
fi

exec "$engine" "$@"
